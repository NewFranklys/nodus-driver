<Window x:Class="NodusDriver.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NodusDriver.ViewModels"
        Title="NODUS Driver"
        Width="920" Height="660"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppBackground}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentDark}" Margin="0,0,10,0">
                        <TextBlock Text="N" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="NODUS Driver" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="  preview" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Width="42" Height="36" Padding="0" Click="Minimize_Click" ToolTip="Minimize">
                        <TextBlock Text="—" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Width="42" Height="36" Padding="0" Click="Close_Click" ToolTip="Close">
                        <TextBlock Text="×" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="38,30,38,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Your drivers" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="NODUS checks Windows Update for drivers that match this PC."
                               Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding ScanCommand}"
                        VerticalAlignment="Top" Padding="12,8" ToolTip="Scan again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↻" FontSize="14" Margin="0,0,7,0"/>
                        <TextBlock Text="Scan again" FontSize="11"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20"
                    Margin="0,26,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentDark}" Margin="0,0,15,0">
                        <TextBlock Text="✓" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="560"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="INSTALLED" Foreground="{StaticResource TextSecondary}" FontSize="9" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding InstalledDriverCount}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="LAST SCAN" Foreground="{StaticResource TextSecondary}" FontSize="9" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LastScan}" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="2,0,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Available updates" FontSize="13" FontWeight="SemiBold"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding UpdateCount}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBlock Text=" found" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Updates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="16,14"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Left"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                            <TextBlock Text="{Binding VersionSummary}" Foreground="{StaticResource Accent}" FontSize="10" Margin="0,5,0,0"/>
                                            <WrapPanel Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Manufacturer}" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                                <TextBlock Text="  ·  " Foreground="#4E5662" FontSize="10"/>
                                                <TextBlock Text="{Binding DriverClass}" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                                <TextBlock Text="  ·  " Foreground="#4E5662" FontSize="10"/>
                                                <TextBlock Text="{Binding Size}" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="20,0,0,0">
                                            <TextBlock Text="Driver date" Foreground="{StaticResource TextSecondary}" FontSize="9" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DriverVersionDate}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="4" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="Microsoft Windows Update only · no ads · no telemetry"
                               Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>

                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding InstallCommand}"
                            HorizontalAlignment="Right"
                            Padding="18,10">
                        <TextBlock Text="{Binding InstallButtonText}" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
