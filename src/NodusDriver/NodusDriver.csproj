<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NodusDriver.ico</ApplicationIcon>
    <AssemblyName>NodusDriver</AssemblyName>
    <RootNamespace>NodusDriver</RootNamespace>
    <Version>0.1.9</Version>
    <Authors>Franklys</Authors>
    <Description>Free and open-source Windows driver updater powered by Microsoft Windows Update.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\NodusLogoD2.png" />
    <Resource Include="Assets\NodusMarkD2.png" />
  </ItemGroup>
</Project>
