<Window x:Class="NodusDriver.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NodusDriver.ViewModels"
        Title="NODUS Driver"
        Width="1120" Height="760"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}"
        Loaded="Window_Loaded"
        Icon="/NodusDriver;component/Assets/NodusMarkD2.png">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Background="{StaticResource AppBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#071011"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NODUS Driver" Foreground="{StaticResource TextMuted}"
                               FontSize="10" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Width="40" Height="32" Padding="0"
                                Click="Minimize_Click" ToolTip="Minimize">
                            <TextBlock Text="—" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Width="40" Height="32" Padding="0"
                                Click="Close_Click" ToolTip="Close">
                            <TextBlock Text="×" FontSize="15"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource SidebarBackground}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="24,22,20,22">
                                        <Image Source="/NodusDriver;component/Assets/NodusLogoD2.png"
                                               Width="156" Height="52" Stretch="Uniform"
                                               HorizontalAlignment="Left"/>
                                        <Border Background="{StaticResource SurfaceRaised}" CornerRadius="4"
                                                Padding="6,3" Margin="1,9,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="PREVIEW 0.1.9" Foreground="{StaticResource TextMuted}"
                                                       FontSize="8" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="SECTIONS" Foreground="{StaticResource TextMuted}"
                                               FontSize="8" FontWeight="Bold" Margin="27,0,0,8"/>

                                    <TabPanel Grid.Row="2" IsItemsHost="True" Background="Transparent"/>

                                    <StackPanel Grid.Row="3" Margin="26,0,22,22">
                                        <Border Height="1" Background="{StaticResource Border}" Margin="0,0,0,14"/>
                                        <TextBlock Text="MICROSOFT WINDOWS UPDATE" Foreground="{StaticResource TextMuted}"
                                                   FontSize="8" FontWeight="Bold"/>
                                        <TextBlock Text="No ads · No telemetry" Foreground="{StaticResource TextSecondary}"
                                                   FontSize="9" Margin="0,5,0,0"/>
                                        <TextBlock Text="Open source preview" Foreground="{StaticResource TextMuted}"
                                                   FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource AppBackground}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <TabItem Header="Overview" Style="{StaticResource NavTabItem}">
                    <Grid Margin="38,30,38,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SYSTEM OVERVIEW" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="This PC at a glance" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                <TextBlock Text="Drivers and hardware status, without the noise."
                                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,7,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ScanCommand}" VerticalAlignment="Top"
                                    Padding="18,10" MinWidth="112">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Scan this PC" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="10" Margin="0,28,0,0" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource Accent}" CornerRadius="10,0,0,10"/>
                                <StackPanel Grid.Column="1" Margin="22,18,24,18">
                                    <TextBlock Text="{Binding Status}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource TextSecondary}"
                                               FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="560"/>
                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                                        <ProgressBar Style="{StaticResource NodusProgressBar}" IsIndeterminate="True"/>
                                        <TextBlock Text="Scanning in stages: hardware → Windows Update → package comparison"
                                                   Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Grid.Column="2" Margin="0,18,22,18" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="DETECTED" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding InstalledDriverCount}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock Text="drivers" Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="1" Background="{StaticResource Border}"/>
                                    <StackPanel Grid.Column="2" Margin="20,0,0,0">
                                        <TextBlock Text="LAST SCAN" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding LastScan}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Text="local time" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,30,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DRIVER STATUS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                                <Border Height="1" Background="{StaticResource Border}" Margin="0,9,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ConfirmedUpgradeCount}" FontSize="24" FontWeight="SemiBold"/>
                                        <TextBlock Text="New versions" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding PackageRefreshCount}" FontSize="24" FontWeight="SemiBold"/>
                                        <TextBlock Text="Package refreshes" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding UpdateCount}" FontSize="24" FontWeight="SemiBold"/>
                                        <TextBlock Text="Total offers" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="HARDWARE INVENTORY" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                                <Border Height="1" Background="{StaticResource Border}" Margin="0,9,0,14"/>
                                <TextBlock Text="{Binding HardwareCount}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Detected driver-backed devices" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <TextBlock Text="Network " Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                    <TextBlock Text="{Binding NetworkDeviceCount}" FontSize="9" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                    <TextBlock Text="Display " Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                    <TextBlock Text="{Binding DisplayDeviceCount}" FontSize="9" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                    <TextBlock Text="Audio " Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                    <TextBlock Text="{Binding AudioDeviceCount}" FontSize="9" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                    <TextBlock Text="Bluetooth " Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                    <TextBlock Text="{Binding BluetoothDeviceCount}" FontSize="9" FontWeight="SemiBold"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                                Margin="0,30,0,0" Padding="0,14,0,0" VerticalAlignment="Bottom">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SOURCE &amp; PRIVACY" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock Text="Microsoft Windows Update only · no ads · no telemetry · no third-party driver catalog"
                                               Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="NODUS Driver · preview" Foreground="{StaticResource TextMuted}"
                                           FontSize="9" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Drivers" Style="{StaticResource NavTabItem}">
                    <Grid Margin="38,30,38,28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DRIVERS" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="Review before you install" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                <TextBlock Text="Only packages reported as compatible by Microsoft Windows Update are shown here."
                                           Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,7,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻" FontSize="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="Scan again"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,26,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Available packages" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="  /  " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Text="{Binding PackageCountText}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Select packages to install" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Updates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                                                Padding="12,14" Margin="0,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource SelectionCheckBox}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="  ·  " Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Text="{Binding OfferLabel}" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding VersionSummary}" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,5,0,0"/>
                                                    <TextBlock Text="{Binding MetadataSummary}" Foreground="{StaticResource TextMuted}" FontSize="9.5" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                                                    <TextBlock Text="DRIVER DATE" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding DriverVersionDate}" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}"
                                        MinWidth="170" Padding="20,11">
                                    <TextBlock Text="{Binding InstallButtonText}" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Hardware" Style="{StaticResource NavTabItem}">
                    <Grid Margin="38,30,38,28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="HARDWARE" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="What NODUS can see" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            <TextBlock Text="Read-only inventory from Windows Plug and Play driver data."
                                       Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,24,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding HardwareCountText}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Device · manufacturer · category · driver version"
                                       Foreground="{StaticResource TextMuted}" FontSize="9.5"/>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding HardwareDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="8,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DeviceName}" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Manufacturer}" Foreground="{StaticResource TextMuted}" FontSize="9.5" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="CATEGORY" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="DRIVER VERSION" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding DriverVersion}" FontSize="10" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
