<UserControl x:Class="NodusDriver.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NodusDriver.ViewModels"
             Background="Transparent">
    <UserControl.DataContext>
        <vm:RecoveryViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="RecoveryListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Body"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Rail" Width="3" Margin="0,8,0,8"
                                    Background="{StaticResource Accent}"
                                    HorizontalAlignment="Left" CornerRadius="0,3,3,0"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource AccentBorder}"/>
                                <Setter TargetName="Rail" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="36,27,36,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="RECOVERY" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
                <TextBlock Text="Protection before change" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/>
                <TextBlock Text="NODUS creates a safety snapshot before Windows Update is allowed to change selected drivers."
                           Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,7,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButton}" Click="Refresh_Click" Margin="0,0,8,0">
                    <TextBlock Text="Refresh"/>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Click="OpenRecoveryFolder_Click" Margin="0,0,8,0">
                    <TextBlock Text="Open backups"/>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="OpenSystemRestore_Click">
                    <TextBlock Text="Open System Restore"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Margin="0,23,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource Accent}" CornerRadius="10,0,0,10"/>
                <StackPanel Grid.Column="1" Margin="20,16,20,16">
                    <TextBlock Text="Automatic protection is on" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Before an installation, NODUS asks Windows for a restore point and exports matched OEM driver packages with PnPUtil. If neither protection method succeeds, the install is stopped before any driver change starts."
                               Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="650"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="20,16,22,16" VerticalAlignment="Center">
                    <TextBlock Text="SAFETY POLICY" Style="{StaticResource Meta}" HorizontalAlignment="Right"/>
                    <TextBlock Text="Protect first" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,22,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SNAPSHOTS" Style="{StaticResource Meta}"/>
                <TextBlock Text="{Binding SnapshotCount}" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SnapshotCountText}" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="LATEST" Style="{StaticResource Meta}"/>
                <TextBlock Text="{Binding LatestSnapshotText}" FontSize="11" FontWeight="SemiBold" Margin="0,7,0,0"/>
                <TextBlock Text="History is stored locally on this PC." Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="STORAGE" Style="{StaticResource Meta}"/>
                <TextBlock Text="10 snapshots max" FontSize="11" FontWeight="SemiBold" Margin="0,7,0,0"/>
                <TextBlock Text="Older snapshots are pruned automatically." Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSnapshots}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Snapshots}"
                     SelectedItem="{Binding SelectedSnapshot}"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource RecoveryListItem}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="15,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ProtectionLabel}" Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding CreatedDisplay}" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ResultLabel}" Foreground="{StaticResource Accent}" FontSize="8.5" FontWeight="Bold" Margin="14,1,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedSnapshot}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RECOVERY SNAPSHOT" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CreatedDisplay}" Foreground="{StaticResource TextMuted}" FontSize="9.5" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ResultLabel}" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" VerticalAlignment="Top"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Border}" Margin="0,17,0,15"/>

                        <TextBlock Text="PROTECTION" Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding ProtectionLabel}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding RestorePointMessage}" Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="0,5,0,0" TextWrapping="Wrap"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RESTORE POINT" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding RestorePointCreated}" FontSize="10.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DRIVER BACKUPS" Style="{StaticResource Meta}"/>
                                <TextBlock Text="{Binding BackedUpDriverCount}" FontSize="10.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Border}" Margin="0,17,0,15"/>

                        <TextBlock Text="MATCHED DRIVERS" Style="{StaticResource Meta}"/>
                        <TextBlock Text="{Binding DriverSummary}" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="0,8,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Click="OpenSelectedBackup_Click" IsEnabled="{Binding HasBackup}" Margin="0,0,8,0">
                                <TextBlock Text="Open this backup"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Click="OpenSystemRestore_Click">
                                <TextBlock Text="Windows System Restore"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSnapshots}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="◇" Foreground="{StaticResource Accent}" FontSize="34" HorizontalAlignment="Center"/>
            <TextBlock Text="No recovery snapshots yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="The first snapshot will be created automatically when you install a selected driver package. Nothing is backed up during scan-only use."
                       Foreground="{StaticResource TextSecondary}" FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
