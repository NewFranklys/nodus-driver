<Window x:Class="NodusDriver.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NodusDriver.ViewModels"
        Title="NODUS Driver"
        Width="1000" Height="710"
        MinWidth="840" MinHeight="610"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Background="{StaticResource AppBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#071012"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource NodusMarkDrawing}" Width="31" Height="25" Stretch="Uniform" Margin="0,0,11,0"/>
                        <TextBlock Text="NODUS" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" Driver" FontSize="14" FontWeight="Normal" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <Border Background="#0E191C" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="4" Margin="11,0,0,0" Padding="6,3">
                            <TextBlock Text="PREVIEW" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Width="42" Height="38" Padding="0"
                                Click="Minimize_Click" ToolTip="Minimize">
                            <TextBlock Text="—" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Width="42" Height="38" Padding="0"
                                Click="Close_Click" ToolTip="Close">
                            <TextBlock Text="×" FontSize="15"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="44,34,44,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="2" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="THIS PC" Foreground="{StaticResource Accent}"
                                       FontSize="9" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Drivers for this PC" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="Compatible packages reported by Microsoft Windows Update. No third-party driver catalog."
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,7,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                            Command="{Binding ScanCommand}"
                            VerticalAlignment="Top" Margin="0,4,0,0" Padding="12,8" ToolTip="Scan again">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="14" Margin="0,0,7,0"/>
                            <TextBlock Text="Scan again" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,26,0,24"
                        Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Accent}" CornerRadius="10,0,0,10"/>

                        <Grid Grid.Column="1" Width="46" Height="46" Margin="20,18,16,18">
                            <Ellipse Fill="{StaticResource AccentSoft}" Stroke="{StaticResource AccentBorder}" StrokeThickness="1"/>
                            <Path Data="M 12 23 L 19 30 L 34 14"
                                  Stroke="{StaticResource Accent}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,15,24,15">
                            <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusDetail}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10.5" Margin="0,5,0,0"
                                       TextWrapping="Wrap" MaxWidth="580"/>
                        </StackPanel>

                        <Grid Grid.Column="3" Margin="0,16,22,16" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,22,0">
                                <TextBlock Text="DETECTED" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Text="{Binding InstalledDriverCount}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="drivers" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="0,1,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{StaticResource Border}"/>

                            <StackPanel Grid.Column="2" Margin="22,0,0,0">
                                <TextBlock Text="LAST SCAN" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Text="{Binding LastScan}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock Text="local time" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="1,0,1,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Available packages" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="  /  " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock Text="{Binding PackageCountText}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Select packages to install"
                               Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Updates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="17,14"
                                            Margin="0,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Surface}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#0C1718"/>
                                                        <Setter Property="BorderBrush" Value="#265A56"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Style="{StaticResource SelectionCheckBox}"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Title}"/>

                                                    <Border CornerRadius="4" Padding="6,3" Margin="9,0,0,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource InfoSoft}"/>
                                                                <Setter Property="BorderBrush" Value="#24466F"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OfferKind}" Value="Upgrade">
                                                                        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OfferKind}" Value="Package">
                                                                        <Setter Property="Background" Value="{StaticResource WarningSoft}"/>
                                                                        <Setter Property="BorderBrush" Value="#5A4927"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding OfferLabel}" FontSize="7.5" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Info}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding OfferKind}" Value="Upgrade">
                                                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding OfferKind}" Value="Package">
                                                                            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding VersionSummary}" FontSize="10" Margin="0,6,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OfferKind}" Value="Upgrade">
                                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding OfferKind}" Value="Package">
                                                                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding MetadataSummary}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="9.5" Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                                                <TextBlock Text="DRIVER DATE" Foreground="{StaticResource TextMuted}"
                                                           FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DriverVersionDate}" FontSize="10.5"
                                                           Margin="0,5,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="4" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                        Padding="0,16,0,0" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource NodusMarkDrawing}" Width="20" Height="16" Stretch="Uniform" Margin="0,0,9,0" Opacity="0.8"/>
                            <StackPanel>
                                <TextBlock Text="Microsoft Windows Update only" Foreground="{StaticResource TextSecondary}" FontSize="9.5"/>
                                <TextBlock Text="No ads  ·  No telemetry  ·  No third-party driver catalog"
                                           Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallCommand}"
                                HorizontalAlignment="Right"
                                MinWidth="168" Padding="20,11">
                            <TextBlock Text="{Binding InstallButtonText}" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
