<Window x:Class="NodusDriver.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NodusDriver.ViewModels"
        Title="NODUS Driver"
        Width="980" Height="700"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Background="{StaticResource AppBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0"
                    Background="#0A0D10"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8"
                                Background="{StaticResource AccentSoft}"
                                BorderBrush="{StaticResource AccentBorder}"
                                BorderThickness="1"
                                Margin="0,0,10,0">
                            <TextBlock Text="N" Foreground="{StaticResource Accent}"
                                       FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="NODUS" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" Driver" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <Border Background="{StaticResource SurfaceRaised}" CornerRadius="5" Margin="10,0,0,0" Padding="6,3">
                            <TextBlock Text="PREVIEW" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Width="42" Height="36" Padding="0"
                                Click="Minimize_Click" ToolTip="Minimize">
                            <TextBlock Text="—" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Width="42" Height="36" Padding="0"
                                Click="Close_Click" ToolTip="Close">
                            <TextBlock Text="×" FontSize="15"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1" Margin="42,32,42,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="DRIVER UPDATES" Foreground="{StaticResource Accent}"
                                   FontSize="9" FontWeight="Bold"/>
                        <TextBlock Text="Keep this PC current" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/>
                        <TextBlock Text="NODUS checks Microsoft Windows Update and only shows driver packages that match this hardware."
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,7,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                            Command="{Binding ScanCommand}"
                            VerticalAlignment="Top" Padding="12,9" ToolTip="Scan again">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="14" Margin="0,0,7,0"/>
                            <TextBlock Text="Scan again" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- System summary -->
                <Border Grid.Row="1"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Margin="0,25,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Accent}" CornerRadius="14,0,0,14"/>

                        <Border Grid.Column="1" Width="48" Height="48" CornerRadius="13"
                                Background="{StaticResource AccentSoft}"
                                BorderBrush="{StaticResource AccentBorder}" BorderThickness="1"
                                Margin="20,18,16,18">
                            <TextBlock Text="✓" Foreground="{StaticResource Accent}" FontSize="21" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,15,24,15">
                            <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusDetail}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10.5" Margin="0,5,0,0"
                                       TextWrapping="Wrap" MaxWidth="590"/>
                        </StackPanel>

                        <Grid Grid.Column="3" Margin="0,16,20,16" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,22,0">
                                <TextBlock Text="INSTALLED" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Text="{Binding InstalledDriverCount}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="drivers" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="0,1,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{StaticResource Border}"/>

                            <StackPanel Grid.Column="2" Margin="22,0,0,0">
                                <TextBlock Text="LAST SCAN" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Text="{Binding LastScan}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock Text="local time" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- List heading -->
                <Grid Grid.Row="2" Margin="1,0,1,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Available drivers" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="  ·  " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock Text="{Binding PackageCountText}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Select what you want to install"
                               Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                </Grid>

                <!-- Driver list -->
                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Updates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface}"
                                            BorderBrush="{StaticResource Border}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="17,14"
                                            Margin="0,0,0,9">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Surface}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Style="{StaticResource SelectionCheckBox}"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Title}"/>

                                                    <Border CornerRadius="5" Padding="6,3" Margin="9,0,0,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource InfoSoft}"/>
                                                                <Setter Property="BorderBrush" Value="#24466F"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OfferKind}" Value="Upgrade">
                                                                        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OfferKind}" Value="Package">
                                                                        <Setter Property="Background" Value="{StaticResource WarningSoft}"/>
                                                                        <Setter Property="BorderBrush" Value="#5A4927"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding OfferLabel}" FontSize="7.5" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Info}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding OfferKind}" Value="Upgrade">
                                                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding OfferKind}" Value="Package">
                                                                            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding VersionSummary}" FontSize="10" Margin="0,6,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OfferKind}" Value="Upgrade">
                                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding OfferKind}" Value="Package">
                                                                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding MetadataSummary}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="9.5" Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                                                <TextBlock Text="DRIVER DATE" Foreground="{StaticResource TextMuted}"
                                                           FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DriverVersionDate}" FontSize="10.5"
                                                           Margin="0,5,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Footer/action bar -->
                <Border Grid.Row="4" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                        Padding="0,16,0,0" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Microsoft Windows Update source" Foreground="{StaticResource TextSecondary}" FontSize="9.5"/>
                            <TextBlock Text="No ads  ·  No telemetry  ·  No third-party driver catalog"
                                       Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallCommand}"
                                HorizontalAlignment="Right"
                                MinWidth="160" Padding="18,11">
                            <TextBlock Text="{Binding InstallButtonText}" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
